# PayPilot AI - Backend Environment Configuration (Sandbox)

# PayPal Developer Sandbox Credentials
# Obtain from https://developer.paypal.com/dashboard/applications/sandbox
PAYPAL_CLIENT_ID=your_paypal_sandbox_client_id_here
PAYPAL_CLIENT_SECRET=your_paypal_sandbox_client_secret_here

# PayPal API Base (Sandbox)
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com

# Google Gemini AI Configuration
# Obtain from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3-flash-preview

# Default Currency (USD default for initial prototype)
PAYPAL_CURRENCY_DEFAULT=USD

# Server settings
HOST=0.0.0.0
PORT=8005
ENVIRONMENT=sandbox

# Allowed CORS Origins (comma-separated for multiple)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
