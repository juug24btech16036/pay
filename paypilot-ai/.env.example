# PayPilot AI - Root Environment Reference
# Note: Copy this to backend/.env and populate with your PayPal Sandbox credentials.
# The client secret must NEVER be put in the frontend directory.

# PayPal Sandbox Credentials
PAYPAL_CLIENT_ID=your_paypal_sandbox_client_id_here
PAYPAL_CLIENT_SECRET=your_paypal_sandbox_client_secret_here

# PayPal REST API Base URL
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com

# Defaults
PAYPAL_CURRENCY_DEFAULT=USD
BACKEND_PORT=8005
FRONTEND_PORT=5173
